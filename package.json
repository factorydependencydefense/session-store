{
  "name": "session-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "In-memory session store with expiry and safe serialization.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --packages=external --outfile=dist/index.js",
    "test": "node --test \"test/*.test.js\"",
    "test:security": "node --test \"test/security/**/*.test.js\""
  },
  "dependencies": {
    "jsonwebtoken": "^8.5.1",
    "lodash": "4.17.10",
    "request": "2.88.2",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
